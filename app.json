{
  "expo": {
    "name": "RiseOS",
    "slug": "riseos-mobile",
    "scheme": "riseos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/newLogoWide.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/newLogoWCon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07090D"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "backgroundColor": "#07090D",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/newLogoWide.png",
        "backgroundColor": "#07090D"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.dhel.riseosmobile"
    },
    "web": {
      "favicon": "./assets/newLogoWCon.png",
      "faviconBackground": "#07090D",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-audio",
      "expo-asset"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "173dc44e-f43f-4683-994e-efa9fcf4d9a8"
      }
    }
  }
}
